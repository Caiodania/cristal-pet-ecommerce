# Copie para .env.local (desenvolvimento) ou cadastre na Netlify (produção):
# Site configuration > Environment variables. NUNCA coloque segredos em variáveis
# com prefixo NEXT_PUBLIC_: elas vão para o navegador.
# Explicação de cada uma em docs/backend.md.

# ───────── Site (vai para o navegador) ─────────
# Domínio final, sem barra no fim. Na Netlify, se ficar vazio, usa a variável URL.
NEXT_PUBLIC_SITE_URL=
# Só para `next dev` (porta 3000) com a API em outra porta. Vazio = mesma origem.
NEXT_PUBLIC_API_URL=

# ───────── Painel do dono ─────────
ADMIN_PASSWORD=
# Texto longo e aleatório (ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Obrigatória em produção: assina o cookie do painel e os links temporários.
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=43200

# ───────── Dados: Supabase (produção) ─────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=cristal-pet
# Sem SUPABASE_URL os dados ficam em memória (só desenvolvimento: somem ao reiniciar).
# STORE=memory|supabase   FILES=memory|supabase   (normalmente não precisa)
# ALLOW_MEMORY_STORE=1    (só para forçar memória em produção, nunca recomendado)

# ───────── IA ─────────
# "mock" = simulado (o site mostra "modo demonstração"). Para ligar uma IA de
# verdade, veja docs/backend.md ("Como ligar uma IA de verdade").
IMAGE_PROVIDER=mock
MODEL_PROVIDER=mock
# Quando gerar o arquivo 3D sozinho: never (só pelo painel) | order | confirmed
MODEL_AUTO=never
# Só no modo mock: quanto a "IA" demora para terminar (milissegundos)
MOCK_DELAY_MS=2500
# Chaves dos fornecedores que você ligar (nomes sugeridos):
# OPENAI_API_KEY=
# MESHY_API_KEY=

# ───────── Proteção de custo e abuso ─────────
PREVIEWS_PER_DAY=3
PREVIEWS_PER_DAY_PER_IP=8
# Teto de gasto com IA por dia, em centavos. 0 = sem teto (só com IA simulada!).
PREVIEW_DAILY_BUDGET_CENTS=0
GENERATION_TIMEOUT_MS=300000
MAX_PHOTO_BYTES=5242880
IP_HASH_SALT=
# Cloudflare Turnstile (captcha gratuito). Com as duas definidas, o site pede o desafio.
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=

# ───────── Desenvolvimento ─────────
PORT=8888
# Origens com acesso à API (CORS), separadas por vírgula. Ex.: http://localhost:3000
ALLOWED_ORIGINS=
